{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 0,
  "margin-top": 8,
  "margin-left": 8,
  "margin-right": 8,
  "modules-left": [
    "niri/workspaces",
    "niri/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "mpris",
    "pulseaudio",
    "network",
    "cpu",
    "memory",
    "battery",
    "custom/left-bracket",
    "tray",
    "custom/right-bracket"
  ],
  "niri/workspaces": {
    "format": "{index}",
    "on-click": "activate"
  },
  "niri/window": {
    "format": "{title}",
    "max-length": 50,
    "rewrite": {
      "": "desktop"
    }
  },
  "clock": {
    "format": "[ {:%H:%M   %a %d %b} ]",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt>{calendar}</tt>"
  },
  "mpris": {
    "format": "[ {player_icon} {title} - {artist} ]",
    "format-paused": "[ {status_icon} {title} - {artist} ]",
    "player-icons": {
      "default": "▶",
      "spotify": "♫"
    },
    "status-icons": {
      "paused": "⏸"
    },
    "max-length": 35,
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous"
  },
  "pulseaudio": {
    "format": "[ vol {volume}% ]",
    "format-muted": "[ muted ]",
    "on-click": "pavucontrol",
    "scroll-step": 5
  },
  "network": {
    "format-wifi": "[ {essid} {signalStrength}% ]",
    "format-ethernet": "[ eth {ipaddr} ]",
    "format-disconnected": "[ disconnected ]",
    "tooltip-format": "{ifname}: {ipaddr}/{cidr}"
  },
  "cpu": {
    "format": "[ cpu {usage}% ]",
    "interval": 5
  },
  "memory": {
    "format": "[ mem {percentage}% ]",
    "interval": 5
  },
  "battery": {
    "format": "[ bat {capacity}% ]",
    "format-charging": "[ bat {capacity}% chr ]",
    "states": {
      "warning": 30,
      "critical": 15
    }
  },
  "tray": {
    "spacing": 8,
    "icon-size": 15
  },
  "custom/left-bracket": {
    "format": "["
  },
  "custom/right-bracket": {
    "format": "]"
  }
}